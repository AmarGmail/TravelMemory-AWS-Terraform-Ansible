[web]
web1 ansible_host=35.175.110.90 ansible_user=ubuntu

[database]
# use proxyjump to connect to db1 through web1
db1 ansible_host=10.20.2.43 ansible_user=ubuntu ansible_ssh_common_args='-o IdentitiesOnly=yes -o ProxyCommand="ssh -i ~/.ssh/travelmemory-lab-key.pem -o IdentitiesOnly=yes -W %h:%p ubuntu@35.175.110.90"'

[all:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=~/.ssh/travelmemory-lab-key.pem